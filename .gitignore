# Dados corporativos e resultados de consulta
/data/
/exports/
/extratos/
*.csv
*.xlsx
*.xls
*.pdf

# Credenciais e conexões locais
.env
.env.*
!/config/ambientes.example.json
/config/ambientes.local.json

# Scripts e materiais corporativos com parâmetros reais

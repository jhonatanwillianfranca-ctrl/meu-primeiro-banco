{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "files.associations": {
    "*.sql": "sql"
  },
  "editor.formatOnSave": true,
  "[sql]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.wordWrap": "on"
  },
  "chat.tools.edits.autoApprove": {
    "**/local/operacional/engenharia_reversa_don/analises/**/*.md": true,
    "**/local/operacional/engenharia_reversa_don/CONTINUIDADE.md": true,
    "**": false
  }
}
